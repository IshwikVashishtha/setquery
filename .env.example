# Hugging Face token — used to call the hosted VLM via HF Inference Providers.
# Get one at https://huggingface.co/settings/tokens (Read access is enough).
HF_TOKEN=hf_xxx

# Hosted VLM served through HF's OpenAI-compatible router.
# Model must be available on your account's Inference Providers router
# (list them with the OpenAI client: <client>.models.list()).
VQA_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct